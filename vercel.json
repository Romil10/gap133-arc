{
  "buildCommand": "node scripts/build-extension.mjs",
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "maxDuration": 20
    }
  },
  "headers": [
    {
      "source": "/gap133.mcpb",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/octet-stream"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"gap133.mcpb\""
        }
      ]
    }
  ]
}
